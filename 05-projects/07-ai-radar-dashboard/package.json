{
  "name": "ai-radar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "next lint",
    "data:refresh": "tsx scripts/refresh-data.ts && tsx scripts/refresh-radar-report.ts",
    "data:refresh:offline": "RADAR_OFFLINE=1 tsx scripts/refresh-data.ts && tsx scripts/refresh-radar-report.ts",
    "radar:daily": "tsx scripts/refresh-radar-report.ts",
    "radar:weekly": "RADAR_REPORT_KIND=weekly tsx scripts/refresh-radar-report.ts",
    "setup": "npm run data:refresh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
