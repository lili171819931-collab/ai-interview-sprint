{
  "name": "ai-radar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "next lint",
    "data:refresh": "tsx scripts/refresh-data.ts && tsx scripts/refresh-radar-report.ts && tsx scripts/sync-builder-pulse.ts && tsx scripts/sync-trendradar.ts && tsx scripts/sync-global-hot-topics.ts",
    "data:refresh:offline": "RADAR_OFFLINE=1 tsx scripts/refresh-data.ts && tsx scripts/refresh-radar-report.ts && tsx scripts/sync-builder-pulse.ts && tsx scripts/sync-trendradar.ts && HOT_SKIP_FETCH=1 tsx scripts/sync-global-hot-topics.ts",
    "radar:daily": "tsx scripts/refresh-radar-report.ts",
    "radar:weekly": "RADAR_REPORT_KIND=weekly tsx scripts/refresh-radar-report.ts",
    "pulse:install": "bash scripts/install-builder-pulse.sh",
    "pulse:sync": "tsx scripts/sync-builder-pulse.ts",
    "opp:sync": "tsx scripts/generate-opportunity-report.ts",
    "trendradar:sync": "tsx scripts/sync-trendradar.ts",
    "hot:sync": "tsx scripts/sync-global-hot-topics.ts",
    "aihot:sync": "tsx scripts/sync-aihot.ts",
    "twitter:sync": "tsx scripts/sync-twitter-live.ts",
    "github:sync": "tsx scripts/sync-github-stars.ts",
    "github:hot": "tsx scripts/sync-github-hot.ts",
    "ph:sync": "tsx scripts/sync-producthunt.ts",
    "hourly": "DAILY_MODE=hourly tsx scripts/daily-refresh.ts",
    "daily:refresh": "tsx scripts/daily-refresh.ts",
    "daily:refresh:quick": "DAILY_MODE=quick tsx scripts/daily-refresh.ts",
    "daily:refresh:hot": "DAILY_MODE=hot tsx scripts/daily-refresh.ts",
    "daily:refresh:offline": "RADAR_OFFLINE=1 tsx scripts/daily-refresh.ts",
    "intel:ingest": "tsx scripts/pipeline/ingest.ts",
    "intel:ingest:offline": "INTEL_OFFLINE=1 tsx scripts/pipeline/ingest.ts",
    "intel:cluster": "tsx scripts/pipeline/cluster-events.ts",
    "intel:refresh": "tsx scripts/pipeline/intel-refresh.ts",
    "intel:refresh:offline": "INTEL_OFFLINE=1 INTEL_PUSH_SKIP=1 tsx scripts/pipeline/intel-refresh.ts",
    "intel:briefs": "tsx scripts/pipeline/generate-briefs.ts",
    "intel:push": "tsx scripts/pipeline/push-notify.ts",
    "intel:push:dry": "INTEL_PUSH_DRY_RUN=1 tsx scripts/pipeline/push-notify.ts",
    "intel:qa": "tsx scripts/qa/intel-qa.ts",
    "mcp:intel": "tsx mcp/server.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "history:rebuild": "tsx -e \"import { rebuildHistoryIndex } from './scripts/lib/archive.ts'; console.log(JSON.stringify(rebuildHistoryIndex(process.cwd()), null, 2));\"",
    "setup": "npm run pulse:install && npm run daily:refresh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
