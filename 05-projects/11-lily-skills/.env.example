# Server port
PORT=3210

# SQLite database file (relative to project root, or absolute path)
# DATABASE_PATH=./data/lily-skills.db

# Optional: OpenAI-compatible LLM (used to enrich Agent understanding when available)
# If unset, the Agent runs fully offline with the built-in retrieval/recommendation engine.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# When true, Agent never calls external network and uses offline adapters only
# AGENT_OFFLINE_ONLY=true
