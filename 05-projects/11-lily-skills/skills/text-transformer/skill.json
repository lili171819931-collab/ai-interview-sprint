{
  "name": "Text Transformer",
  "version": "1.0.0",
  "description": "文本处理：大小写转换、去重、去空白、分词统计等",
  "category": "Productivity",
  "tags": ["text", "文本", "处理", "transform", "效率"],
  "icon": "🔤",
  "execution_type": "local",
  "risk_level": "low",
  "permissions": ["read"],
  "input_schema": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "description": "待处理文本", "required": true },
      "operation": { "type": "string", "enum": ["uppercase", "lowercase", "trim", "dedupe_lines", "word_count"], "description": "处理方式", "required": false }
    },
    "required": ["text"]
  },
  "ai_description": "对文本执行常见转换与清理：大小写、去重行、去空白、字数/词数统计，适合内容预处理。",
  "use_cases": ["文本清洗", "内容预处理", "批量整理"],
  "examples": ["把这篇文章转成小写并统计字数"]
}
