generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  department String
  role       String   @default("employee")
  password   String   @default("demo123")
  claims     Claim[]
  createdAt  DateTime @default(now())
}

model CompanyProfile {
  id         String @id @default(cuid())
  legalName  String
  taxpayerId String
  aliasJson  String @default("[]")
}

model Policy {
  id                     String @id @default(cuid())
  version                String @default("baseline-v1")
  hotelLimitTier1        Int    @default(60000)
  hotelLimitTier2        Int    @default(45000)
  hotelLimitOther        Int    @default(35000)
  entertainmentPerCapita Int    @default(20000)
  preApprovalThreshold   Int    @default(100000)
  rulesJson              String @default("{}")
}

model Claim {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  title         String
  periodStart   String
  periodEnd     String
  purpose       String
  modesJson     String     @default("[\"B\"]")
  projectCode   String?
  status        String     @default("draft")
  totalClaimable Int       @default(0)
  totalPending  Int        @default(0)
  totalRejected Int        @default(0)
  totalTax      Int        @default(0)
  rejectionReason String?
  cityTier      String?
  entertainGuests Int?
  invoices      Invoice[]
  attachments   Attachment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Attachment {
  id        String    @id @default(cuid())
  claimId   String
  claim     Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  filename  String
  mime      String
  size      Int
  sha256    String
  storagePath String
  ocrStatus String    @default("pending")
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model Invoice {
  id                   String      @id @default(cuid())
  claimId              String
  claim                Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  attachmentId         String?
  attachment           Attachment? @relation(fields: [attachmentId], references: [id])
  invoiceType          String      @default("UNKNOWN")
  invoiceCode          String      @default("")
  invoiceNumber        String      @default("")
  invoiceDate          String      @default("")
  sellerName           String      @default("")
  sellerTaxId          String      @default("")
  buyerName            String      @default("")
  buyerTaxId           String      @default("")
  amountExclTax        Int         @default(0)
  taxAmount            Int         @default(0)
  amountInclTax        Int         @default(0)
  currency             String      @default("CNY")
  primaryCategory      String      @default("OTHER")
  secondaryCategory    String      @default("默认")
  sceneTagsJson        String      @default("[]")
  complianceStatus     String      @default("conditional")
  complianceReasonsJson String     @default("[]")
  riskScore            Int         @default(0)
  suggestedClaimAmount Int         @default(0)
  confidence           Float       @default(0.5)
  verificationStatus   String      @default("unverified")
  dedupeStatus         String      @default("unique")
  needsUserInputJson   String      @default("[]")
  notes                String      @default("")
  fieldSourceJson      String      @default("{}")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  diffJson   String   @default("{}")
  createdAt  DateTime @default(now())
}
